@model ShopTARge24.Models.RealEstate.RealEstateCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>Update Real Estate</h1>
}
else
{
    <h1>Create Real Estate</h1>
}


<div>
    <form method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="ModifiedAt" type="hidden" />

        <div class="form-group row">
            <label asp-for="Area" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Area" class="form-control" type="number" step="0.01" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Location" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Location" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="RoomNumber" class="form-control" type="number" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="BuildingType" class="form-control" />
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Files" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-5">
                <input class="form-control" asp-for="Files" multiple type="file" />
            </div>
        </div>

        <dl>

            @foreach (var images in Model.Image)
            {
                <partial name="_Images" model="images" />
            }


        </dl>


        @if (Model.Id.HasValue)
        {
            <input asp-action="Update" asp-controller="RealEstate" type="submit" class="btn btn-success" value="Update" />
        }
        else
        {
            <input asp-action="Create" asp-controller="RealEstate" type="submit" class="btn btn-success" value="Create" />
        }

        <a asp-action="Index" asp-controller="RealEstate" class="btn btn-secondary">Back</a>
    </form>
</div>
