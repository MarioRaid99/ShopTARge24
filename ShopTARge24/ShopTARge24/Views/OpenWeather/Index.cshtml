@model ShopTARge24.Models.OpenWeather.OpenWeatherSearchModel

@{
    ViewData["Title"] = "OpenWeather search";
}

<div class="container mt-4">
    <form asp-controller="OpenWeather" asp-action="SearchCity" method="post">
        <div class="container">
            <div class="form-group col-md-offset-3 col-md-5">
                <h2>Search the current forecast in a city</h2>
                <input asp-for="CityName" class="form-control" placeholder="Enter city name..." />
                <span asp-validation-for="CityName" class="text-danger"></span>
            </div>
        </div>

        <div class="container mt-3">
            <div class="form-group col-md-offset-3 col-md-5">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>
    </form>
</div>